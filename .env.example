# Daily Bap — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.

# ============================================================
# DATABASE — Neon Serverless Postgres (Free Tier)
# Get yours at: https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
# ============================================================
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require

# ============================================================
# WHATSAPP BUSINESS NUMBER
# Format: Country code + number, NO + or spaces
# Example for India: 919876543210
# ============================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ============================================================
# KITCHEN LOCATION (Guwahati, Assam)
# Update if the kitchen address changes
# ============================================================
NEXT_PUBLIC_KITCHEN_LAT=26.1445
NEXT_PUBLIC_KITCHEN_LNG=91.7362
NEXT_PUBLIC_DELIVERY_RADIUS_KM=5

# ============================================================
# GOOGLE GEMINI AI
# Get yours at: https://aistudio.google.com/
# ============================================================
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here
